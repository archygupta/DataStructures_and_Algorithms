class Solution {
    // Function to detect cycle in an undirected graph.
    
    public boolean isCycle(int curr, int parent, ArrayList<ArrayList<Integer>> adj, boolean[] visited) {
        if(visited[curr])
            return false;
            
        visited[curr]=true;
        
        for(int i: adj.get(curr)){
            if(!visited[i]){
                if(isCycle(i, curr, adj, visited))
                    return true;
            }
            else if (i!=parent){
                return true;
            }
        }
        return false;
    }
         
    public boolean isCycle(int V, ArrayList<ArrayList<Integer>> adj) {
        boolean[] visited = new boolean[V];
        for(int i=0;i<V;i++){
        if(isCycle(i, -1, adj, visited))
            return true;
        }
        return false;
    }
}

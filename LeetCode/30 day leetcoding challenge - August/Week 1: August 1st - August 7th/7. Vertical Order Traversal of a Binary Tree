class Solution {
  public TreeMap<Integer, ArrayList<Integer>> verticalTraversal(TreeNode root, int hd, TreeMap<Integer, ArrayList<Integer>> map) {
    ArrayList<Integer> li = map.getOrDefault(hd, new ArrayList());
    li.add(root.val);
    map.put(hd, li);
    
    if(root.left!=null)
    {
      verticalTraversal(root.left, hd-1, map);
    }
    if(root.right!=null)
    {
      verticalTraversal(root.right, hd+1, map);
    }
    return map;
  }
  public List<List<Integer>> verticalTraversal(TreeNode root) {
        
        List<List<Integer>> result = new ArrayList();
         if(root==null)
          return result;
        TreeMap<Integer, ArrayList<Integer>> map = new TreeMap<Integer, ArrayList<Integer>>();
          map = verticalTraversal(root, 0, map);
        for(Map.Entry<Integer, ArrayList<Integer>>  m : map.entrySet())
        {
          result.add(m.getValue());
        }
    return result;
    }

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {
    int min_col=0, max_col=0;
    HashMap<Integer, List<int[]>> map = new HashMap<>();

    public void dfs(TreeNode root, int row, int col){
        if(root==null)
            return;

        min_col = Math.min(min_col, col);
        max_col = Math.max(max_col, col);

        map.putIfAbsent(col, new ArrayList<int[]>());
        map.get(col).add(new int[]{row, root.val});

        dfs(root.left, row+1, col-1);
        dfs(root.right, row+1, col+1);
    }

    public List<List<Integer>> verticalTraversal(TreeNode root) {
        List<List<Integer>> res = new ArrayList<>();
        if(root==null)
            return res;

        dfs(root, 0, 0);

        for(int i=min_col ; i<=max_col ; i++){
            List<int[]> li = map.get(i);
            Collections.sort(li, new Comparator<int[]>(){
                public int compare(int[] a, int[] b){
                    if (a[0] == b[0]) {
                        return a[1] - b[1];
                    } else {
                        return a[0] - b[0];
                    }
                }
            });
            List<Integer> temp = new ArrayList<>();
            for(int[] num : li){
                temp.add(num[1]);
            }
            res.add(temp);
        }

        return res;
    }
}


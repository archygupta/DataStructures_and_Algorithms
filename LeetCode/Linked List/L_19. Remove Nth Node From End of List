class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        if(head == null)
            return null;

        int count = 0;
        ListNode temp = head;
        while(temp!=null){
            count++;
            temp=temp.next;
        }

        if(count == n){
            head = head.next;
            return head;
        }


        n = count - n;
        temp = head;
        while(n > 1){
            temp = temp.next;
            n--;
        }

        temp.next = temp.next == null ? null : temp.next.next;

        return head;
    }
}

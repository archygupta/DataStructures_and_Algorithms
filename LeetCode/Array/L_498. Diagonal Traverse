/*Given an m x n matrix mat, return an array of all the elements of the array in a diagonal order.

Example 1:
Input: mat = [[1,2,3],[4,5,6],[7,8,9]]
Output: [1,2,4,7,5,3,6,8,9]

Example 2:
Input: mat = [[1,2],[3,4]]
Output: [1,2,3,4]

Constraints:
m == mat.length
n == mat[i].length
1 <= m, n <= 104
1 <= m * n <= 104
-105 <= mat[i][j] <= 105
*/

https://www.youtube.com/watch?v=NTF7sDU0IWA

class Solution {
    public int[] findDiagonalOrder(int[][] mat) {
        if(mat.length == 0 || mat[0].length == 0)
            return new int[]{};
        
        int r = mat.length, c = mat[0].length;
        int[] res = new int[r*c];
        int idx = 0;
        int row = 0, col = 0;
        boolean up = true;

        while(row<r && col<c){
            if(up){
                while(row>0 && col<c-1){
                    res[idx++] = mat[row][col];
                    row--;
                    col++;
                }
                res[idx++] = mat[row][col];
                if(col == c-1){
                    row++;
                }
                else{
                    col++;
                }
            }
            else{
                while(row < r-1 && col > 0){
                    res[idx++] = mat[row][col];
                    row++;
                    col--;
                }
                res[idx++] = mat[row][col];
                if(row == r-1){
                    col++;
                }
                else{
                    row++;
                }

            }
            up = !up;
        }
        return res;
    }
}



class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        HashSet<Integer> numSet = new HashSet<>();
        for(int idx = 0; idx < nums.length; idx++){
            if(numSet.contains(nums[idx])) return true;
            numSet.add(nums[idx]);
            if(numSet.size() > k){
                numSet.remove(nums[idx-k]);
            }
        }
        return false;
    }
}


Given an integer array arr, partition the array into (contiguous) subarrays of length at most k. After partitioning, each subarray has their values changed to become the maximum value of that subarray.
Return the largest sum of the given array after partitioning. Test cases are generated so that the answer fits in a 32-bit integer.

Example 1:
Input: arr = [1,15,7,9,2,5,10], k = 3
Output: 84
Explanation: arr becomes [15,15,15,9,10,10,10]

Example 2:
Input: arr = [1,4,1,5,7,3,6,1,9,9,3], k = 4
Output: 83

Example 3:
Input: arr = [1], k = 1
Output: 1
 
Constraints:
1 <= arr.length <= 500
0 <= arr[i] <= 109
1 <= k <= arr.length

class Solution {

    public int maxSumAfterPartitioningHelper(int idx, int[] arr, int k, int[] dp){
        int n = arr.length;
        if(idx == n){
            return 0;
        }
        if(dp[idx]!=-1)
            return dp[idx];

        int len = 0, max = Integer.MIN_VALUE, maxAns = Integer.MIN_VALUE;
        for(int j = idx ; j < Math.min(idx+k, n) ; j++){
            len++;
            max = Math.max(max, arr[j]);
            int sum  = len*max + maxSumAfterPartitioningHelper(j+1, arr, k , dp);
            maxAns = Math.max(maxAns, sum);
        }
        return dp[idx] = maxAns;
    }

    public int maxSumAfterPartitioning(int[] arr, int k) {
        int n = arr.length;
        int[] dp = new int[n];
        Arrays.fill(dp, -1);
        return maxSumAfterPartitioningHelper(0, arr, k, dp);
    }
}

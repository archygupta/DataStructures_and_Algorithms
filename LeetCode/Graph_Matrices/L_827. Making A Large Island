/*
You are given an n x n binary matrix grid. You are allowed to change at most one 0 to be 1.

Return the size of the largest island in grid after applying this operation.

An island is a 4-directionally connected group of 1s.

 

Example 1:

Input: grid = [[1,0],[0,1]]
Output: 3
Explanation: Change one 0 to 1 and connect two 1s, then we get an island with area = 3.
Example 2:

Input: grid = [[1,1],[1,0]]
Output: 4
Explanation: Change the 0 to 1 and make the island bigger, only one island with area = 4.
Example 3:

Input: grid = [[1,1],[1,1]]
Output: 4
Explanation: Can't change any 0 to 1, only one island with area = 4.
 

Constraints:

n == grid.length
n == grid[i].length
1 <= n <= 500
grid[i][j] is either 0 or 1.

*/

class Solution {

    int[][] dir = new int[][]{{1,0}, {-1,0}, {0,1}, {0,-1}};
    class IslandSize{
        int count;
    }
    public int largestIslandHelper(HashMap<Integer, Integer> map, int[][] grid, 
    int i, int j, int m, int n){
                System.out.println(i+" "+j);

        Set<Integer> temp = new HashSet<>();
        int count=1;
        for(int d=0;d<dir.length;d++){
            int newI=i+dir[d][0], newJ = j+dir[d][1];
                    
             if(newI<0 || newI>=m || newJ<0 || newJ>=n || grid[newI][newJ]==0){
                continue;
            }
            int currIsland = grid[newI][newJ];
            if(!temp.contains(currIsland)){
                count+=map.get(currIsland);
            }
            temp.add(grid[newI][newJ]);
        }
       
        return count;
    }

    public void dfs(int[][] grid, int i, int j, int m, int n, IslandSize island, int idx){
        if(i<0 || i>=m || j<0 || j>=n || grid[i][j]!=1){
            return;
        }
        grid[i][j]=idx;
        island.count++;

        for(int d=0;d<dir.length;d++){
            int newI=i+dir[d][0], newJ = j+dir[d][1];
            dfs(grid, newI, newJ, m, n, island, idx);
        }
    }

    public int largestIsland(int[][] grid) {
        int m=grid.length, n=grid[0].length;
        HashMap<Integer, Integer> map = new HashMap<>();
        int res=Integer.MIN_VALUE;
        int idx=2;
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                 if(grid[i][j]==1){
                    IslandSize island = new IslandSize();
                    dfs(grid, i, j, m, n, island, idx);
                    map.put(idx, island.count);
                    idx++;
                 }
            }
        }
        
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]==0){
                    res = Math.max(res, largestIslandHelper(map, grid, i, j, m, n));
                }
            }
        }
        if( res==Integer.MIN_VALUE && map.size()==1)
           {
            for(Map.Entry<Integer, Integer> mp: map.entrySet()){
                return mp.getValue();
            }
           }
        return res == Integer.MIN_VALUE ? 0 : res;
    }
}

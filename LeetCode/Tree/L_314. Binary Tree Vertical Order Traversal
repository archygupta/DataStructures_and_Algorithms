/*
Given the root of a binary tree, return the vertical order traversal of its nodes' values. (i.e., from top to bottom, column by column).
If two nodes are in the same row and column, the order should be from left to right.

Example 1:
Input: root = [3,9,20,null,null,15,7]
Output: [[9],[3,15],[20],[7]]

Example 2:
Input: root = [3,9,8,4,0,1,7]
Output: [[4],[9],[3,0,1],[8],[7]]

Example 3:
Input: root = [3,9,8,4,0,1,7,null,null,null,2,5]
Output: [[4],[9,5],[3,0,1],[8,2],[7]]
 
Constraints:
The number of nodes in the tree is in the range [0, 100].
-100 <= Node.val <= 100
*/

class Solution {
    int min_col=0, max_col=0;
    HashMap<Integer, List<int[]>> map = new HashMap<>();

    public void dfs(TreeNode root, int row, int col){
        if(root==null)
            return;
        
        min_col = Math.min(min_col, col);
        max_col = Math.max(max_col, col);

        map.putIfAbsent(col, new ArrayList<int[]>());
        map.get(col).add(new int[]{row, root.val});

        dfs(root.left, row+1, col-1);
        dfs(root.right, row+1, col+1);
    }

    public List<List<Integer>> verticalOrder(TreeNode root) {
        List<List<Integer>> res = new ArrayList<>();
        if(root==null)
            return res;
        dfs(root, 0, 0);
        
        for(int i = min_col ; i<=max_col ; i++){
            List<int[]> li = map.get(i);
            Collections.sort(li, new Comparator<int[]>(){
                public int compare(int[] a, int[] b){
                    return a[0]-b[0];
                }
            });
            List<Integer> temp = new ArrayList<>();
            for(int[] ele : li){
                temp.add(ele[1]);
            }
            res.add(temp);
        }
        return res;
    }
}

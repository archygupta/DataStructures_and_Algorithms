/*
Given the root of a binary tree, return an array of the largest value in each row of the tree (0-indexed).

 

Example 1:


Input: root = [1,3,2,5,3,null,9]
Output: [1,3,9]
Example 2:

Input: root = [1,2,3]
Output: [1,3]
 

Constraints:

The number of nodes in the tree will be in the range [0, 104].
-231 <= Node.val <= 231 - 1

*/

class Solution {
    public List<Integer> largestValues(TreeNode root) {
        List<Integer> largestValuesRes = new ArrayList<>();

        if(root==null){
            return largestValuesRes;
        }

        Queue<TreeNode> treeNodes = new LinkedList<>();
        treeNodes.add(root);
        largestValuesRes.add(root.val);

        while(!treeNodes.isEmpty()){
            int size = treeNodes.size();
            long largestVal = Long.MIN_VALUE;

            while(size>0){
                TreeNode tempNode = treeNodes.poll();
                if(tempNode.left!=null){
                    largestVal = Math.max(largestVal, tempNode.left.val);
                    treeNodes.add(tempNode.left);
                }
                if(tempNode.right!=null){
                    largestVal = Math.max(largestVal, tempNode.right.val);
                    treeNodes.add(tempNode.right);
                }
                size--;
            }
            if(largestVal!= Long.MIN_VALUE)
                largestValuesRes.add((int)largestVal);
        }
        return largestValuesRes;
    }
}

/*
Given the root of a binary tree, the value of a target node target, and an integer k, return an array of the values of all nodes that have a distance k from the target node.

You can return the answer in any order.

Example 1:
Input: root = [3,5,1,6,2,0,8,null,null,7,4], target = 5, k = 2
Output: [7,4,1]
Explanation: The nodes that are a distance 2 from the target node (with value 5) have values 7, 4, and 1.

Example 2:
Input: root = [1], target = 1, k = 3
Output: []
 
Constraints:
The number of nodes in the tree is in the range [1, 500].
0 <= Node.val <= 500
All the values Node.val are unique.
target is the value of one of the nodes in the tree.
0 <= k <= 1000
*/

class Solution {

    public void dfs(int target, int k, HashMap<Integer, List<Integer>> map, List<Integer> res, HashSet<Integer> visited){
        if(visited.contains(target))
            return;

        visited.add(target);

        if(k==0){
            res.add(target);
            return;
        }

        List<Integer> li = map.get(target);
        for(int i : li){
            if(!visited.contains(i)){
                dfs(i, k-1, map, res, visited);
            }
        }
    }

    public List<Integer> distanceK(TreeNode root, TreeNode target, int k) {
        HashMap<Integer, List<Integer>> map = new HashMap<>();
        HashSet<Integer> visited = new HashSet<>();
        makeMap(map, visited, root, null);
        List<Integer> res = new ArrayList<>();
        visited.clear();
        dfs(target.val, k, map, res, visited);
        return res;
    }

    public void makeMap(HashMap<Integer, List<Integer>> map, HashSet<Integer> visited , TreeNode root, TreeNode parent){
        if(root == null || visited.contains(root.val)){
            return;
        }
        visited.add(root.val);
        if(parent==null)
            map.putIfAbsent(root.val, new ArrayList<>());
        else
            {
                map.putIfAbsent(root.val, new ArrayList<>());
                map.get(root.val).add(parent.val);
                map.get(parent.val).add(root.val);
            }
        makeMap(map, visited, root.left, root);
        makeMap(map, visited, root.right, root);
    }
}

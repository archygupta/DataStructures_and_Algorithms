class Solution {
    public void moveZeroes(int[] nums) {
        int index = -1;
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=0){
                nums[++index] = nums[i];
            }
        }
        while(index<nums.length-1){
            nums[++index] = 0;
        } 
    }
}
